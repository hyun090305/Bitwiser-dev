{
  "name": "bitwiser-dev",
  "version": "1.0.0",
  "description": "Bitwiser game project",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "cross-env ELECTRON_CACHE=.electron-cache ELECTRON_BUILDER_CACHE=.electron-builder-cache electron-builder",
    "test": "node --test tests/*.test.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "preview:demo": "node scripts/preview-demo.mjs",
    "test:demo:browser": "node scripts/verify-demo-browser.mjs && node scripts/verify-demo-recovery.mjs && node scripts/verify-demo-features.mjs && node scripts/verify-chapter-access-browser.mjs",
    "test:full:web": "node scripts/verify-full-browser.mjs",
    "test:full:electron": "electron scripts/verify-full-electron.cjs",
    "test:memory:browser": "node scripts/verify-memory-browser.mjs",
    "test:stages:browser": "node scripts/verify-stage-memory-browser.mjs",
    "test:map:browser": "node scripts/verify-stage-map-browser.mjs",
    "stages:generate": "node scripts/generate-memory-stages.mjs && node scripts/integrate-memory20.mjs && node scripts/restructure-stage-map.mjs",
    "stages:memory20": "node scripts/integrate-memory20.mjs && node scripts/restructure-stage-map.mjs",
    "stages:compact": "node scripts/compact-memory20.mjs --search && npm run stages:memory20",
    "test:memory20": "node --test tests/memory20.test.mjs",
    "test:memory20:browser": "node scripts/verify-memory20-browser.mjs",
    "test:grading:browser": "node scripts/verify-grading-browser.mjs",
    "test:results:browser": "node scripts/verify-result-browser.mjs",
    "test:cost:browser": "node scripts/build-demo.mjs && node scripts/verify-cost-browser.mjs"
  },
  "build": {
    "appId": "com.bitwiser.game",
    "productName": "Bitwiser",
    "files": [
      "index.html",
      "style.css",
      "lang.js",
      "background.js",
      "manifest.json",
      "service-worker.js",
      "oauth-callback.html",
      "gif.js",
      "gif.worker.js",
      "levels.json",
      "levels_en.json",
      "stage_map.json",
      "*.json",
      "src/**/*",
      "assets/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "icon": "assets/icon.ico",
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "playwright": "^1.62.1"
  }
}
